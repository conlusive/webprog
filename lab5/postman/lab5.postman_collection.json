{
  "info": {
    "name": "Лабораторна робота 5 - кешуючий проксі",
    "description": "Колекцію запускати на ПОРОЖНІЙ теці кешу (Collection Runner, порядок запитів важливий). Адреса сервера - у змінній колекції baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET /404 - картинки немає в кеші",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type: image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg'));",
              "pm.test('X-Image-Source: http.cat', () => pm.expect(pm.response.headers.get('X-Image-Source')).to.eql('http.cat'));",
              "// запам'ятовуємо розмір і час першого запиту для наступних кроків",
              "pm.collectionVariables.set('catSize', pm.response.responseSize);",
              "pm.collectionVariables.set('firstTime', pm.response.responseTime);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. GET /404 - повторно (з кешу)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type: image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg'));",
              "pm.test('X-Image-Source: cache', () => pm.expect(pm.response.headers.get('X-Image-Source')).to.eql('cache'));",
              "pm.test('Та сама картинка (розмір збігається з першим запитом)', () => pm.expect(pm.response.responseSize).to.eql(Number(pm.collectionVariables.get('catSize'))));",
              "console.log('Час відповіді: перший GET = ' + pm.collectionVariables.get('firstTime') + ' мс, повторний GET = ' + pm.response.responseTime + ' мс');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. PUT /404 - власна картинка",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/404",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "404"
          ]
        },
        "body": {
          "mode": "file",
          "file": {
            "src": "test-data/my-picture.jpg"
          }
        }
      },
      "response": []
    },
    {
      "name": "4. GET /404 - після PUT (моя картинка)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type: image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.eql('image/jpeg'));",
              "pm.test('X-Image-Source: cache', () => pm.expect(pm.response.headers.get('X-Image-Source')).to.eql('cache'));",
              "pm.test('Це не картинка з http.cat (розмір інший)', () => pm.expect(pm.response.responseSize).to.not.eql(Number(pm.collectionVariables.get('catSize'))));"
            ]
          }
        }
      ],
      "request": {
